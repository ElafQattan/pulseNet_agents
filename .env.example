# Copy this file to .env in the repository root (.env is git-ignored, so keys never reach GitHub).
# agentkit.py loads it with python-dotenv. Nothing else is needed.

# Your OpenRouter key: every model call goes through OpenRouter. Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# The main model. Chosen after testing the free tool-calling models on the same prompt (see README, "Models").
AGENT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Backups when the main model is rate-limited. OpenRouter accepts at most 3 models per request (main + 2).
AGENT_FALLBACKS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free

# Not needed: HF_TOKEN. The GSMA datasets on Hugging Face and the embedding model are public.
